# =============================================================================
# PhishGuard - AI-Based Phishing URL & Threat Intelligence Correlation System
# Environment Configuration Example
# Copy this file to .env and configure your keys.
# NEVER commit .env or expose secrets in frontend code.
# =============================================================================

# Backend Server
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
EXTERNAL_API_TIMEOUT_SECONDS=8

# Supabase PostgreSQL (Optional - falls back to local SQLite when omitted)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Threat Intelligence API Keys (Keep backend-only!)
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
ABUSEIPDB_API_KEY=

# Frontend API Endpoint (used in frontend/.env)
VITE_API_BASE_URL=http://127.0.0.1:8000
